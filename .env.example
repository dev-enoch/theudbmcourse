# Database Configuration
# MONGODB_URI: The connection string for your MongoDB database. Used by Mongoose to connect to the DB.
MONGODB_URI=""

# NextAuth Configuration
# NEXTAUTH_SECRET: A random string used to hash tokens, sign cookies and generate cryptographic keys in NextAuth.
NEXTAUTH_SECRET=local_nextauth_secret_key_placeholder_for_builds
# NEXTAUTH_URL: The canonical URL of your site, used by NextAuth to generate correct callback URLs.
NEXTAUTH_URL=http://localhost:3000

# Custom Access Flow Configuration
# JWT_SECRET: A secure secret key used to sign and verify custom JSON Web Tokens (e.g., for Payonaire token validation).
JWT_SECRET=local_jwt_secret_key_placeholder_for_builds

# Resend Email Configuration
# RESEND_API_KEY: Your API key from Resend (resend.com) used to send transactional emails.
RESEND_API_KEY=re_123456789
# EMAIL_FROM: The verified sender email address that emails will be sent from (e.g., hello@yourdomain.com).
EMAIL_FROM=onboarding@resend.dev
# RESEND_ACTIVATION_TEMPLATE_ID: The specific Resend template ID used for sending account activation emails.
RESEND_ACTIVATION_TEMPLATE_ID=template_activation_uuid
# RESEND_RESEND_TEMPLATE_ID: The specific Resend template ID used for resending certain notifications/receipts.
RESEND_RESEND_TEMPLATE_ID=template_resend_uuid

# Application URL
# APP_URL: The base URL of the application (e.g., http://localhost:3000 locally, or https://yourdomain.com in prod).
APP_URL=http://localhost:3000

# Webhook Secrets
# PAYONAIRE_WEBHOOK_SECRET: The secret key used to verify that incoming Payonaire webhooks are authentic and haven't been tampered with.
PAYONAIRE_WEBHOOK_SECRET=your_payonaire_webhook_secret_here

# Cron Secrets
# CRON_SECRET: A secret key used to secure your automated background tasks (cron jobs), like the daily-ping route.
CRON_SECRET=your_cron_secret_here

# Maintenance Mode
# MAINTENANCE_MODE: Set to "true" to put the site into maintenance mode.
MAINTENANCE_MODE=false